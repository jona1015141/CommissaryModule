DROP TABLE IF EXISTS raw_materials;
CREATE TABLE raw_materials (
    id TEXT PRIMARY KEY,
    material_name TEXT,
    current_stock REAL,
    status TEXT
);
INSERT INTO raw_materials VALUES ('#RM-1001', 'Dressed Chicken', 120.0, 'Low Stock');
INSERT INTO raw_materials VALUES ('#RM-1002', 'Jasmine Rice', 450.0, 'In Stock');
INSERT INTO raw_materials VALUES ('#RM-1003', 'Cooking Oil', 80.0, 'In Stock');

DROP TABLE IF EXISTS active_batches;
CREATE TABLE active_batches (
    batch_id TEXT PRIMARY KEY,
    recipe_target TEXT,
    target_yield INTEGER,
    status TEXT
);
INSERT INTO active_batches VALUES ('#BATCH-2026-004', 'Classic Chicken Pastil Tubs', 300, 'Low Ingredient Alert');
INSERT INTO active_batches VALUES ('#BATCH-2026-005', 'Spicy Pastil Tubs', 150, 'Ready to Start');

DROP TABLE IF EXISTS deliveries;
CREATE TABLE deliveries (
    delivery_id TEXT PRIMARY KEY,
    branch_name TEXT,
    items_summary TEXT,
    status TEXT
);
INSERT INTO deliveries VALUES ('#DEL-2026-001', 'Balagtas', '70 Total Units', 'Ready to Dispatch');
INSERT INTO deliveries VALUES ('#DEL-2026-003', 'Meycauayan', '50 Total Units', 'Low Cold Storage');

DROP TABLE IF EXISTS purchase_orders;
CREATE TABLE purchase_orders (
    po_number TEXT PRIMARY KEY,
    supplier_name TEXT,
    total_value REAL,
    status TEXT
);
INSERT INTO purchase_orders VALUES ('#PO-2026-089', 'Magnolia Poultry', 45000.00, 'Draft Pending');

DROP TABLE IF EXISTS wastages;
CREATE TABLE wastages (
    id TEXT PRIMARY KEY,
    branch_name TEXT,
    item_name TEXT,
    quantity REAL,
    unit TEXT,
    estimated_cost REAL,
    reason TEXT,
    date_recorded TEXT
);
