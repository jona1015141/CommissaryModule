CREATE TABLE IF NOT EXISTS raw_materials (
    id TEXT PRIMARY KEY,
    material_name TEXT,
    current_stock REAL,
    status TEXT
);

CREATE TABLE IF NOT EXISTS active_batches (
    batch_id TEXT PRIMARY KEY,
    recipe_target TEXT,
    target_yield INTEGER,
    status TEXT
);

CREATE TABLE IF NOT EXISTS deliveries (
    delivery_id TEXT PRIMARY KEY,
    branch_name TEXT,
    items_summary TEXT,
    status TEXT
);

CREATE TABLE IF NOT EXISTS purchase_orders (
    po_number TEXT PRIMARY KEY,
    supplier_name TEXT,
    total_value REAL,
    status TEXT
);

CREATE TABLE IF NOT EXISTS wastages (
    id TEXT PRIMARY KEY,
    branch_name TEXT,
    item_name TEXT,
    quantity REAL,
    unit TEXT,
    estimated_cost REAL,
    reason TEXT,
    date_recorded TEXT
);

