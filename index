        // DOCUMENT PRINTING SIMULATOR
        function printDocument(title, details) {
            const printArea = document.getElementById('printable-area');
            printArea.innerHTML = `
                <div style="font-family: Arial, sans-serif; border: 2px solid #1b3b1e; padding: 30px; max-width: 600px; margin: auto;">
                    <h1 style="color: #1b3b1e; border-bottom: 2px solid #1b3b1e; padding-bottom: 10px;">CHICK PASTIL COMMISSARY</h1>
                    <h2 style="margin-top: 20px;">${title}</h2>
                    <pre style="font-size: 14px; background: #f3f4f6; padding: 15px; border-radius: 5px; white-space: pre-wrap;">${details}</pre>
                </div>
            `;
            window.print();
        }
    </script>
