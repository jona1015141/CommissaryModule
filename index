<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chick Pastil Commissary Management System</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1b3b1e',      /* Deep Commissary Green */
                            accent: '#427d27',    /* Vibrant Action Green */
                            amber: '#f59e0b',     /* Pending / Warning Amber */
                            red: '#dc2626',       /* Warning / Alert Red */
                            bg: '#f3f4f6',        /* Light Gray App Background */
                            panel: '#ffffff'
                        }
                    }
                }
            }
        }
    </script>

    <!-- Html5-QRCode Library for WebCam Barcode & QR Scanning -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <style>
        @media print {
            body * { visibility: hidden; }
            #printable-area, #printable-area * { visibility: visible; }
            #printable-area { position: absolute; left: 0; top: 0; width: 100%; padding: 20px; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-brand-bg font-sans text-gray-800 antialiased min-h-screen flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="bg-brand-dark text-white shadow-md no-print">
        <div class="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <!-- Authentic Logo Render Header -->
                <div class="bg-white px-3 py-1 rounded-lg shadow flex items-center justify-center border border-gray-100">
                    <div class="text-center font-black tracking-tight leading-none text-red-600 text-xs">
                        <span class="block text-[8px] text-red-700 tracking-widest font-extrabold uppercase">Tine's Kitchen</span>
                        <span class="text-sm font-extrabold text-red-600 tracking-wider">CHICK<span class="text-green-800 font-black px-0.5">N</span>PASTIL</span>
                    </div>
                </div>
                <span class="text-sm font-semibold tracking-wide text-gray-200 border-l border-gray-600 pl-3">Commissary Management System</span>
            </div>
            <div class="flex items-center space-x-3 text-sm">
                <div class="w-9 h-9 rounded-full bg-brand-accent flex items-center justify-center font-bold text-white shadow border border-white/20">US</div>
                <div>
                    <p class="font-bold leading-none">User Staff Full Name</p>
                    <p class="text-xs text-gray-300">User Staff Role</p>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Application Shell -->
    <div class="flex-1 flex max-w-7xl w-full mx-auto my-4 bg-white rounded-lg shadow-lg overflow-hidden border border-gray-200">
        
        <!-- Sidebar Menu -->
        <aside class="w-64 bg-brand-dark text-white p-4 flex flex-col justify-between no-print">
            <div>
                <!-- Authentic Logo Render Sidebar -->
                <div class="bg-white p-3 rounded-xl mb-6 shadow-md flex flex-col items-center justify-center border border-gray-100">
                    <span class="text-[9px] font-black text-red-700 uppercase tracking-widest">TINE'S KITCHEN</span>
                    <div class="text-lg font-black text-red-600 tracking-wider flex items-center my-0.5">
                        <span>CHICK</span>
                        <span class="bg-green-800 text-white px-1.5 py-0.5 rounded text-xs mx-1 font-extrabold">N</span>
                        <span>PASTIL</span>
                    </div>
                    <span class="text-[8px] text-green-800 font-bold uppercase tracking-wider">Authentic Foodhouse</span>
                </div>

                <nav class="space-y-2">
                    <p class="text-xs text-gray-400 uppercase font-semibold px-3 mb-2">Main Menu</p>
                    <button onclick="switchTab('raw-materials')" id="nav-raw-materials" class="w-full text-left px-4 py-2.5 rounded-lg transition font-medium text-sm flex items-center space-x-2 bg-brand-accent text-white">
                        <span>📦 Raw Materials</span>
                    </button>
                    <button onclick="switchTab('active-batches')" id="nav-active-batches" class="w-full text-left px-4 py-2.5 rounded-lg transition font-medium text-sm flex items-center space-x-2 text-gray-300 hover:bg-white/10">
                        <span>🍳 Active Batches</span>
                    </button>
                    <button onclick="switchTab('deliveries')" id="nav-deliveries" class="w-full text-left px-4 py-2.5 rounded-lg transition font-medium text-sm flex items-center space-x-2 text-gray-300 hover:bg-white/10">
                        <span>🚚 Deliveries & Logistics</span>
                    </button>
                    <button onclick="switchTab('purchase-orders')" id="nav-purchase-orders" class="w-full text-left px-4 py-2.5 rounded-lg transition font-medium text-sm flex items-center space-x-2 text-gray-300 hover:bg-white/10">
                        <span>📝 Purchase Orders</span>
                    </button>
                    <button onclick="switchTab('wastages')" id="nav-wastages" class="w-full text-left px-4 py-2.5 rounded-lg transition font-medium text-sm flex items-center space-x-2 text-gray-300 hover:bg-white/10">
                        <span>🗑️ Wastages & Spoilage</span>
                    </button>
                </nav>
            </div>
        </aside>

        <!-- Dynamic Screen Area -->
        <main class="flex-1 p-6 bg-gray-50 overflow-y-auto">

            <!-- SCREEN 1: RAW MATERIALS MODULE -->
            <section id="screen-raw-materials" class="space-y-6">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-brand-dark">Raw Materials Inventory</h1>
                        <p class="text-sm text-gray-500">Scan items or manually adjust stock levels.</p>
                    </div>
                    <button onclick="openScanModal()" class="bg-brand-accent hover:bg-green-700 text-white font-bold px-5 py-2.5 rounded-lg shadow flex items-center space-x-2 transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        <span>Scan Barcode / QR</span>
                    </button>
                </div>

                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
                    <table class="w-full text-left text-sm text-gray-700">
                        <thead class="bg-gray-100 text-gray-600 font-semibold border-b">
                            <tr>
                                <th class="p-3">Item ID</th>
                                <th class="p-3">Material Name</th>
                                <th class="p-3">Category</th>
                                <th class="p-3">Current Stock</th>
                                <th class="p-3">Status</th>
                                <th class="p-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y" id="raw-materials-table-body">
                            <tr>
                                <td class="p-3 font-mono text-xs font-bold text-gray-600">#RM-1001</td>
                                <td class="p-3 font-semibold text-gray-900">Dressed Chicken</td>
                                <td class="p-3">Poultry / Raw Meat</td>
                                <td class="p-3 font-bold text-red-600">120.0 kg</td>
                                <td class="p-3"><span class="bg-red-100 text-red-700 px-2.5 py-1 rounded-full text-xs font-bold">Low Stock (Min: 150kg)</span></td>
                                <td class="p-3 text-center">
                                    <button onclick="openAdjustmentModal('Dressed Chicken', 'RM-1001', 120.0)" class="bg-brand-accent text-white px-3 py-1.5 rounded font-bold text-xs hover:bg-green-700 transition">Adjust Stock</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-xs font-bold text-gray-600">#RM-1002</td>
                                <td class="p-3 font-semibold text-gray-900">Jasmine Rice</td>
                                <td class="p-3">Grains</td>
                                <td class="p-3 font-bold text-gray-800">450.0 kg</td>
                                <td class="p-3"><span class="bg-green-100 text-green-700 px-2.5 py-1 rounded-full text-xs font-bold">In Stock</span></td>
                                <td class="p-3 text-center">
                                    <button onclick="openAdjustmentModal('Jasmine Rice', 'RM-1002', 450.0)" class="bg-brand-accent text-white px-3 py-1.5 rounded font-bold text-xs hover:bg-green-700 transition">Adjust Stock</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- SCREEN 2: ACTIVE BATCHES MODULE -->
            <section id="screen-active-batches" class="space-y-6 hidden">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-brand-dark">Active Kitchen Batches</h1>
                        <p class="text-sm text-gray-500">Monitor kitchen cooking runs and recipe auto-deductions.</p>
                    </div>
                </div>
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
                    <table class="w-full text-left text-sm text-gray-700">
                        <thead class="bg-gray-100 text-gray-600 font-semibold border-b">
                            <tr>
                                <th class="p-3">Batch ID</th>
                                <th class="p-3">Recipe Target</th>
                                <th class="p-3">Target Yield</th>
                                <th class="p-3">Status</th>
                                <th class="p-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            <tr>
                                <td class="p-3 font-mono text-xs font-bold text-gray-600">#BATCH-2026-004</td>
                                <td class="p-3 font-semibold text-gray-900">Classic Chicken Pastil Tubs</td>
                                <td class="p-3">300 Tubs</td>
                                <td class="p-3"><span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full text-xs font-bold">Low Ingredient Alert</span></td>
                                <td class="p-3 text-center">
                                    <button onclick="openRecipeModal('FAILED')" class="bg-brand-accent text-white px-3 py-1.5 rounded font-bold text-xs hover:bg-green-700 transition">View / Scan QR</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-xs font-bold text-gray-600">#BATCH-2026-005</td>
                                <td class="p-3 font-semibold text-gray-900">Spicy Pastil Tubs</td>
                                <td class="p-3">150 Tubs</td>
                                <td class="p-3"><span class="bg-green-100 text-green-800 px-2.5 py-1 rounded-full text-xs font-bold">Ready to Start</span></td>
                                <td class="p-3 text-center">
                                    <button onclick="openRecipeModal('SUCCESS')" class="bg-brand-accent text-white px-3 py-1.5 rounded font-bold text-xs hover:bg-green-700 transition">View / Scan QR</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- SCREEN 3: DELIVERIES MODULE -->
            <section id="screen-deliveries" class="space-y-6 hidden">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-brand-dark">Deliveries & Logistics</h1>
                        <p class="text-sm text-gray-500">Manage branch orders and vehicle dispatching.</p>
                    </div>
                </div>
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
                    <table class="w-full text-left text-sm text-gray-700">
                        <thead class="bg-gray-100 text-gray-600 font-semibold border-b">
                            <tr>
                                <th class="p-3">Delivery ID</th>
                                <th class="p-3">Branch Name</th>
                                <th class="p-3">Items Summary</th>
                                <th class="p-3">Status</th>
                                <th class="p-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            <tr>
                                <td class="p-3 font-mono text-xs font-bold text-gray-600">#DEL-2026-001</td>
                                <td class="p-3 font-semibold text-gray-900">Balagtas Branch</td>
                                <td class="p-3">70 Total Units</td>
                                <td class="p-3"><span class="bg-green-100 text-green-800 px-2.5 py-1 rounded-full text-xs font-bold">Ready to Dispatch</span></td>
                                <td class="p-3 text-center">
                                    <button onclick="openDeliveryModal('READY')" class="bg-brand-accent text-white px-3 py-1.5 rounded font-bold text-xs hover:bg-green-700 transition">View Order</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-xs font-bold text-gray-600">#DEL-2026-003</td>
                                <td class="p-3 font-semibold text-gray-900">Meycauayan Branch</td>
                                <td class="p-3">50 Total Units</td>
                                <td class="p-3"><span class="bg-red-100 text-red-800 px-2.5 py-1 rounded-full text-xs font-bold">Low Cold Storage</span></td>
                                <td class="p-3 text-center">
                                    <button onclick="openDeliveryModal('WARNING')" class="bg-brand-accent text-white px-3 py-1.5 rounded font-bold text-xs hover:bg-green-700 transition">View Order</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- SCREEN 4: PURCHASE ORDERS MODULE -->
            <section id="screen-purchase-orders" class="space-y-6 hidden">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-brand-dark">Purchase Orders & Procurement</h1>
                        <p class="text-sm text-gray-500">Automated procurement drafts triggered by low stock thresholds.</p>
                    </div>
                </div>
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
                    <table class="w-full text-left text-sm text-gray-700">
                        <thead class="bg-gray-100 text-gray-600 font-semibold border-b">
                            <tr>
                                <th class="p-3">PO Number</th>
                                <th class="p-3">Supplier Name</th>
                                <th class="p-3">Total Value</th>
                                <th class="p-3">Trigger Reason</th>
                                <th class="p-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            <tr>
                                <td class="p-3 font-mono text-xs font-bold text-gray-600">#PO-2026-089</td>
                                <td class="p-3 font-semibold text-gray-900">Magnolia Poultry</td>
                                <td class="p-3 font-bold text-gray-900">₱ 45,000.00</td>
                                <td class="p-3"><span class="bg-red-100 text-red-800 px-2.5 py-1 rounded-full text-xs font-bold">Low Stock</span></td>
                                <td class="p-3 text-center">
                                    <button onclick="openPOModal('#PO-2026-089')" class="bg-brand-accent text-white px-3 py-1.5 rounded font-bold text-xs hover:bg-green-700 transition">Review Draft</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- SCREEN 5: WASTAGES & SPOILAGE MODULE -->
            <section id="screen-wastages" class="space-y-6 hidden">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-brand-dark">Wastages & Spoilage Log</h1>
                        <p class="text-sm text-gray-500">Monitor damaged, expired, or spoiled raw materials in real-time.</p>
                    </div>
                    <button onclick="openWastageFormModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2 rounded-lg text-sm flex items-center space-x-2 transition shadow">
                        <span>+ Record Wastage</span>
                    </button>
                </div>
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
                    <table class="w-full text-left text-sm text-gray-700">
                        <thead class="bg-gray-100 text-gray-600 font-semibold border-b">
                            <tr>
                                <th class="p-3">Waste ID</th>
                                <th class="p-3">Item Name</th>
                                <th class="p-3">Quantity Wasted</th>
                                <th class="p-3">Reason / Notes</th>
                                <th class="p-3">Date Recorded</th>
                            </tr>
                        </thead>
                        <tbody id="wastage-table-body" class="divide-y">
                            <tr>
                                <td colspan="5" class="p-4 text-center text-gray-400">Loading wastage records...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

        </main>
    </div>

    <!-- MODAL CONTAINER OVERLAY -->
    <div id="modal-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div id="modal-content" class="bg-white rounded-xl shadow-2xl max-w-xl w-full p-6 relative transform transition-all border border-gray-200">
            <!-- Modal Body Injected Dynamically -->
        </div>
    </div>

    <!-- PRINTABLE DOCUMENT CONTAINER -->
    <div id="printable-area" class="hidden"></div>

    <!-- COMPLETE JAVASCRIPT LOGIC -->
    <script>
        // Tab Navigation Switcher
        function switchTab(tabId) {
            ['raw-materials', 'active-batches', 'deliveries', 'purchase-orders', 'wastages'].forEach(id => {
                const screen = document.getElementById(`screen-${id}`);
                const nav = document.getElementById(`nav-${id}`);
                if(screen) screen.classList.add('hidden');
                if(nav) nav.className = "w-full text-left px-4 py-2.5 rounded-lg transition font-medium text-sm flex items-center space-x-2 text-gray-300 hover:bg-white/10";
            });
            const activeScreen = document.getElementById(`screen-${tabId}`);
            const activeNav = document.getElementById(`nav-${tabId}`);
            if(activeScreen) activeScreen.classList.remove('hidden');
            if(activeNav) activeNav.className = "w-full text-left px-4 py-2.5 rounded-lg transition font-medium text-sm flex items-center space-x-2 bg-brand-accent text-white";

            if(tabId === 'wastages') loadWastages();
        }

        // Modal Helpers
        function closeModal() {
            document.getElementById('modal-overlay').classList.add('hidden');
            if (window.html5QrcodeScanner) {
                window.html5QrcodeScanner.clear().catch(e => console.error(e));
            }
        }

        function showModalHtml(html) {
            const container = document.getElementById('modal-content');
            container.innerHTML = html;
            document.getElementById('modal-overlay').classList.remove('hidden');
        }

        // SCANNER INTERFACE
        function openScanModal() {
            showModalHtml(`
                <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold z-20">×</button>
                <h2 class="text-xl font-bold text-brand-dark mb-1">Scan Item Barcode / QR</h2>
                <p class="text-xs text-gray-500 mb-3">Position barcode/QR code inside camera frame to auto-fill stock details.</p>
                <div id="qr-reader" class="w-full bg-gray-100 rounded-xl overflow-hidden min-h-[220px] border border-gray-200"></div>
                <div class="mt-4 text-center">
                    <button onclick="simulateScanSuccess()" class="text-xs font-bold text-brand-accent underline hover:text-green-800">
                        Click Here for Manual Entry (Simulate Scan)
                    </button>
                </div>
            `);
            setTimeout(() => {
                try {
                    const html5QrcodeScanner = new Html5QrcodeScanner("qr-reader", {
                        fps: 10,
                        qrbox: { width: 200, height: 200 },
                        rememberLastUsedCamera: true
                    }, false);
                    window.html5QrcodeScanner = html5QrcodeScanner;
                    html5QrcodeScanner.render((decodedText) => {
                        html5QrcodeScanner.clear();
                        simulateScanSuccess();
                    }, (error) => {});
                } catch(e) {
                    console.log("Scanner ready.");
                }
            }, 100);
        }

        function simulateScanSuccess() {
            openAdjustmentModal('Dressed Chicken', 'RM-1001', 120.0);
        }

        // RAW MATERIALS: ADJUSTMENT MODAL
        function openAdjustmentModal(itemName, itemId, currentQty) {
            showModalHtml(`
                <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold">×</button>
                <h2 class="text-xl font-bold text-brand-dark mb-1">Stock Adjustment Form</h2>
                <p class="text-xs text-gray-500 mb-4 font-mono">Item ID: #${itemId}</p>
                <div class="space-y-4">
                    <div class="bg-gray-50 p-3 rounded-lg border">
                        <p class="text-xs text-gray-500">Material Name</p>
                        <p class="text-base font-bold text-gray-800">${itemName}</p>
                        <p class="text-xs text-gray-500 mt-1">Current Balance: <span class="font-bold text-gray-800">${currentQty} kg</span></p>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Adjustment Type</label>
                        <select id="adj-type" class="w-full border rounded-lg p-2 text-sm bg-white font-medium">
                            <option value="restock">Restock (+ Addition)</option>
                            <option value="spoilage">Spoilage / Waste (- Deduction)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Quantity (kg/L)</label>
                        <input type="number" id="adj-qty" value="50.0" class="w-full border rounded-lg p-2 text-sm font-bold text-gray-800">
                    </div>
                    <div class="flex space-x-3 pt-2">
                        <button onclick="closeModal()" class="w-1/2 bg-red-600 text-white font-bold py-2.5 rounded-lg text-sm hover:bg-red-700 transition">CANCEL</button>
                        <button onclick="saveStockAdjustment('${itemName}', '${itemId}')" class="w-1/2 bg-brand-accent text-white font-bold py-2.5 rounded-lg text-sm hover:bg-green-700 transition">SAVE & UPDATE</button>
                    </div>
                </div>
            `);
        }

        function saveStockAdjustment(itemName, itemId) {
            showModalHtml(`
                <div class="text-center py-4 space-y-4">
                    <div class="w-14 h-14 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">✓</div>
                    <h2 class="text-2xl font-black text-brand-dark">INVENTORY UPDATED SUCCESSFULLY!</h2>
                    <p class="text-sm text-gray-600">Stock balance for <strong>${itemName}</strong> (#${itemId}) has been updated in database.</p>
                    <div class="flex justify-center space-x-3 pt-2">
                        <button onclick="printDocument('Stock Tag - ${itemName}', 'Item ID: #${itemId}')" class="bg-amber-500 text-white font-bold px-4 py-2 rounded-lg text-xs hover:bg-amber-600">PRINT TAG</button>
                        <button onclick="closeModal()" class="bg-brand-accent text-white font-bold px-4 py-2 rounded-lg text-xs hover:bg-green-700">DONE</button>
                    </div>
                </div>
            `);
        }

        // WASTAGES MODULE LOGIC & FORM
        function openWastageFormModal() {
            showModalHtml(`
                <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold">×</button>
                <h2 class="text-xl font-bold text-brand-dark mb-1">Record Material Spoilage / Wastage</h2>
                <p class="text-xs text-gray-500 mb-4">Log damaged or expired materials to update inventory counts automatically.</p>
                <form onsubmit="submitWastage(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Item Name</label>
                        <input type="text" id="waste-item" required placeholder="e.g. Dressed Chicken" class="w-full border rounded-lg p-2 text-sm font-medium">
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Quantity Wasted</label>
                            <input type="number" step="0.1" id="waste-qty" required value="5.0" class="w-full border rounded-lg p-2 text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Unit</label>
                            <select id="waste-unit" class="w-full border rounded-lg p-2 text-sm bg-white font-medium">
                                <option value="kg">kg</option>
                                <option value="liters">liters</option>
                                <option value="pcs">pcs</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Reason / Notes</label>
                        <input type="text" id="waste-reason" required placeholder="e.g. Power outage spoilage" class="w-full border rounded-lg p-2 text-sm font-medium">
                    </div>
                    <div class="flex space-x-3 pt-2">
                        <button type="button" onclick="closeModal()" class="w-1/2 bg-gray-500 text-white font-bold py-2.5 rounded-lg text-sm">CANCEL</button>
                        <button type="submit" class="w-1/2 bg-red-600 text-white font-bold py-2.5 rounded-lg text-sm hover:bg-red-700">SAVE WASTAGE</button>
                    </div>
                </form>
            `);
        }

        async function submitWastage(e) {
            e.preventDefault();
            const item_name = document.getElementById('waste-item').value;
            const quantity = document.getElementById('waste-qty').value;
            const unit = document.getElementById('waste-unit').value;
            const reason = document.getElementById('waste-reason').value;

            try {
                const res = await fetch('http://localhost:3000/api/wastages', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ item_name, quantity, unit, reason })
                });
                if (res.ok) {
                    closeModal();
                    loadWastages();
                } else {
                    alert('Failed to save wastage record.');
                }
            } catch (err) {
                console.error("Error submitting wastage:", err);
            }
        }

        async function loadWastages() {
            try {
                const res = await fetch('http://localhost:3000/api/wastages');
                const wastages = await res.json();
                const tbody = document.getElementById('wastage-table-body');
                
                if (!tbody) return;
                
                if (wastages.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-gray-400">No wastage records found.</td></tr>`;
                    return;
                }

                tbody.innerHTML = wastages.map(w => `
                    <tr class="hover:bg-gray-50 transition">
                        <td class="p-3 font-mono text-xs font-bold text-gray-600">${w.id}</td>
                        <td class="p-3 font-semibold text-gray-900">${w.item_name}</td>
                        <td class="p-3 font-semibold text-red-600">-${w.quantity} ${w.unit}</td>
                        <td class="p-3 text-gray-600">${w.reason}</td>
                        <td class="p-3 text-gray-500">${w.date}</td>
                    </tr>
                `).join('');
            } catch (err) {
                console.error("Error loading wastages:", err);
            }
        }

        // BATCHES MODAL
        function openRecipeModal(status) {
            if (status === 'SUCCESS') {
                showModalHtml(`
                    <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold">×</button>
                    <h2 class="text-xl font-bold text-brand-dark">Recipe Details - #BATCH-2026-005</h2>
                    <p class="text-xs text-gray-500 mb-4">Spicy Pastil Tubs (Yield: 150 Tubs)</p>
                    <div class="bg-green-50 border border-green-200 p-3 rounded-lg mb-4 text-xs text-green-800 font-semibold">
                        ✓ All required ingredients available in inventory storage.
                    </div>
                    <div class="flex space-x-3">
                        <button onclick="closeModal()" class="w-1/2 bg-red-600 text-white font-bold py-2.5 rounded-lg text-sm">CANCEL</button>
